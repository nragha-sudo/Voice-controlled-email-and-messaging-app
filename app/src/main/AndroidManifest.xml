<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Runtime-requested: needed for on-device speech-to-text (reply capture,
         voice command capture) via android.speech.SpeechRecognizer. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- SpeechRecognizer may fall back to a network recognition service. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Optional: lets speech recognition "bias" toward contact names (see
         RecognizerIntent.EXTRA_BIASING_STRINGS) so uncommon names transcribe
         correctly. The app works without this permission — biasing is just
         skipped and recognition falls back to the plain language model. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- SMS source: lets SmsReceiver observe incoming SMS_RECEIVED broadcasts
         and (best-effort, see sms/SmsReadMarker.kt) query the platform SMS
         provider. Neither permission requires/implies default-SMS-app status. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- Lets the voice "reply" flow send an SMS reply via SmsManager (see
         sms/SmsSender.kt). Unlike SmsReadMarker's mark-as-read write, sending
         is a normal dangerous permission — it does not require/imply
         default-SMS-app status. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Local API server: keeps it alive in the background as a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.VoiceAccessMessenger"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Stage 1: captures incoming Outlook/WhatsApp notifications and queues
             them in Room. Requires the user to grant Notification Access in
             system settings (Settings > Apps > Special app access). -->
        <service
            android:name=".notification.MessageNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Stage 3: reads full message bodies, drives search, and sends replies
             by walking the on-screen accessibility node tree of Outlook/WhatsApp.
             Requires the user to enable this service under
             Settings > Accessibility > Downloaded apps. -->
        <service
            android:name=".accessibility.MessageAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- SMS source: queues incoming texts into the same message_queue table
             as Outlook/WhatsApp, tagged SourceApp.SMS. Requires RECEIVE_SMS,
             granted at runtime (see MainActivity). exported=true is required
             for the system to deliver this broadcast at all. -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Local HTTP server exposing the message queue over the network (see
             server/LocalApiServer.kt) for per-source querying from Claude,
             intended to be reached only over Tailscale — see README. Runs as
             a foreground service so it survives the screen turning off. -->
        <service
            android:name=".server.ApiServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
