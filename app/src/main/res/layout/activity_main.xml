<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textPermissionBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF3CD"
            android:padding="12dp"
            android:textColor="#664D03"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Notification access is off — tap to enable" />

        <TextView
            android:id="@+id/textUnreadCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Unread: 3" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editSearchKeywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_search"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <!-- Each column: logo-only play/pause button (tap = start that source's unread queue, tap again = pause), its unread count, and that source's own Search/Clear Cache buttons. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayPauseWhatsapp"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:insetLeft="0dp"
                    app:insetTop="0dp"
                    app:insetRight="0dp"
                    app:insetBottom="0dp"
                    android:contentDescription="@string/cd_play_pause_whatsapp"
                    app:icon="@drawable/ic_whatsapp"
                    app:iconSize="40dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:cornerRadius="32dp" />

                <TextView
                    android:id="@+id/textUnreadWhatsapp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textSize="12sp"
                    tools:text="5 unread" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearchWhatsapp"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minWidth="0dp"
                    android:text="@string/btn_search"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearCacheWhatsapp"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/btn_clear_cache"
                    android:textColor="#B3261E"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayPauseOutlook"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:insetLeft="0dp"
                    app:insetTop="0dp"
                    app:insetRight="0dp"
                    app:insetBottom="0dp"
                    android:contentDescription="@string/cd_play_pause_outlook"
                    app:icon="@drawable/ic_outlook"
                    app:iconSize="40dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:cornerRadius="32dp" />

                <TextView
                    android:id="@+id/textUnreadOutlook"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textSize="12sp"
                    tools:text="2 unread" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearchOutlook"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minWidth="0dp"
                    android:text="@string/btn_search"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearCacheOutlook"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/btn_clear_cache"
                    android:textColor="#B3261E"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayPauseSms"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:insetLeft="0dp"
                    app:insetTop="0dp"
                    app:insetRight="0dp"
                    app:insetBottom="0dp"
                    android:contentDescription="@string/cd_play_pause_sms"
                    app:icon="@drawable/ic_sms"
                    app:iconSize="40dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:cornerRadius="32dp" />

                <TextView
                    android:id="@+id/textUnreadSms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textSize="12sp"
                    tools:text="1 unread" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearchSms"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minWidth="0dp"
                    android:text="@string/btn_search"
                    android:textSize="11sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearCacheSms"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/btn_clear_cache"
                    android:textColor="#B3261E"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoiceCommand"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/btn_voice_command" />

        <!-- Rarely used, so styled to stand out (yellow, full-width, like the old Stop bar) rather than tucked away quietly. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearCacheAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#F2C94C"
            android:text="@string/btn_clear_cache"
            android:textColor="#3D3200" />

        <!-- Replay / Done / Reply / Skip: answers whichever message is currently
             being read/awaiting a decision, exactly like saying the matching
             word aloud — see VoiceAssistantController.submitAction. Icon-only,
             bold glyphs, so each carries a contentDescription for TalkBack. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActionReplay"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                app:insetLeft="0dp"
                app:insetTop="0dp"
                app:insetRight="0dp"
                app:insetBottom="0dp"
                android:contentDescription="@string/cd_action_replay"
                app:icon="@drawable/ic_action_replay"
                app:iconSize="28dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActionDone"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:insetLeft="0dp"
                app:insetTop="0dp"
                app:insetRight="0dp"
                app:insetBottom="0dp"
                android:contentDescription="@string/cd_action_done"
                app:icon="@drawable/ic_action_done"
                app:iconSize="28dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActionReply"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:insetLeft="0dp"
                app:insetTop="0dp"
                app:insetRight="0dp"
                app:insetBottom="0dp"
                android:contentDescription="@string/cd_action_reply"
                app:icon="@drawable/ic_action_reply"
                app:iconSize="28dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnActionSkip"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                app:insetLeft="0dp"
                app:insetTop="0dp"
                app:insetRight="0dp"
                app:insetBottom="0dp"
                android:contentDescription="@string/cd_action_skip"
                app:icon="@drawable/ic_action_skip"
                app:iconSize="28dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textSize="14sp"
            tools:text="Ready" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="#E0E0E0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_api_server_section"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textServerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            tools:text="Server stopped" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_start_server" />

        <TextView
            android:id="@+id/textApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textIsSelectable="true"
            android:textSize="12sp"
            tools:text="API key: aBcD1234…" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyApiKey"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_copy_api_key" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegenerateApiKey"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/btn_regenerate_api_key" />
        </LinearLayout>

        <TextView
            android:id="@+id/textTailscaleHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#666666"
            android:textSize="12sp"
            tools:text="Reach this server at http://&lt;tailscale ip&gt;:8765 — see README for setup." />

    </LinearLayout>
</ScrollView>
